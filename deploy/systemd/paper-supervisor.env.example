# Paths must be absolute and contain no credentials.
HYPERLAB_PAPER_CONFIG=/var/lib/hyperlab/phase12-live-paper/authorization-ba84444240af6cdbfc3df4f0170866a2a0c15c1f-linux-cpython-3.12.13/paper-config.json
HYPERLAB_PAPER_DB=/var/lib/hyperlab/phase12-live-paper/paper/paper.sqlite3

